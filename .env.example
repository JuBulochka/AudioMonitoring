# =============================================================================
# PumpJack Audio Monitor — Environment Configuration
# Copy to .env and fill in your values
# =============================================================================

# Django
DJANGO_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DB_NAME=pumpjack_db
DB_USER=pumpjack
DB_PASSWORD=pumpjack_secret
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Storage — local by default, set to 's3' for S3-compatible
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# S3 / MinIO (when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=pumpjack-audio
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Device Token
DEVICE_TOKEN_SALT=device-token-salt-change-me

# Celery Beat
CELERY_BEAT_SCHEDULE_ENABLED=True

# Notifications
OFFLINE_THRESHOLD_MINUTES=90
CRITICAL_ALERT_EMAIL_ENABLED=False
ALERT_EMAIL_FROM=alerts@pumpjack.local
ALERT_EMAIL_RECIPIENTS=ops@pumpjack.local

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Sentry (optional)
SENTRY_DSN=

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# Audio settings
AUDIO_MAX_FILE_SIZE_MB=50
AUDIO_RETENTION_DAYS=90

# Remote access
REMOTE_ACCESS_TOKEN_TTL_MINUTES=30
